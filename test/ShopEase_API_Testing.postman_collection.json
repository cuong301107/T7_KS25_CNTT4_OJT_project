    {
      "name": "2. Categories & Products CRUD",
      "item": [
        {
          "name": "2.1 Public - Get Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "categories"
              ]
            }
          }
        },
        {
          "name": "2.2 Public - Get Products List (Search, Filter, Pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?page=1&limit=10&keyword=iPhone&sort=price_desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "iPhone"
                },
                {
                  "key": "sort",
                  "value": "price_desc"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 Public - Get Product Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "{{product_id}}"
              ]
            }
          }
        },
        {
          "name": "2.4 Admin - Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"MacBook Pro M3 14 inch\", \"categoryId\": 2, \"price\": 39990000, \"stockQuantity\": 10, \"description\": \"Laptop Apple Silicon M3 manh me\"}"
            },
            "url": {
              "raw": "{{base_url}}/admin/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "products"
              ]
            }
          }
        }
      ]
    },
