    {
      "name": "6. Security & Authorization Checks",
      "item": [
        {
          "name": "6.1 Access Cart without Token (Expect 401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/cart",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cart"
              ]
            }
          }
        },
        {
          "name": "6.2 Access Admin API with Customer Token (Expect 403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/stats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "stats"
              ]
            }
          }
        },
        {
          "name": "6.3 Login with Wrong Password (Expect 401/400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"customer@shopease.com\", \"password\": \"WrongPassword\"}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
