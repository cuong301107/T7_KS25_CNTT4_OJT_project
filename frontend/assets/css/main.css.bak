/* ============================================================
   ShopEase - Giao dien toi gian
   ============================================================ */
:root {
  --bg: #f4f5f7;
  --surface: #ffffff;
  --surface-2: #fafafa;
  --surface-3: #f1f2f4;
  --border: #e6e8eb;
  --border-strong: #d3d6da;
  --text: #14161a;
  --text-2: #4b5057;
  --text-3: #7a8087;
  --text-invert: #ffffff;
  --primary: #17191d;
  --primary-hover: #2b2e33;
  --primary-soft: #e8e9eb;
  --ring: rgba(23, 25, 29, 0.14);
  --danger: #b42318;
  --danger-soft: #fdecea;
  --success: #1a7f37;
  --success-soft: #e9f6ec;
  --warning: #9a6700;
  --warning-soft: #fdf3d9;
  --info: #175d8d;
  --info-soft: #e8f1f8;
  --radius: 14px;
  --radius-sm: 9px;
  --radius-xs: 6px;
  --shadow-sm: 0 1px 2px rgba(20, 22, 26, 0.05);
  --shadow: 0 1px 2px rgba(20, 22, 26, 0.05), 0 4px 16px rgba(20, 22, 26, 0.06);
  --shadow-lg: 0 12px 40px rgba(20, 22, 26, 0.12);
  --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --header-h: 64px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  font-size: 15px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }
button { font-family: inherit; cursor: pointer; }
input, select, textarea { font-family: inherit; font-size: 14px; }

.container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
.page { padding: 28px 0 64px; min-height: calc(100vh - var(--header-h) - 220px); }

/* ---------- Header ---------- */
.site-header {
  position: sticky; top: 0; z-index: 50;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  height: var(--header-h);
}
.header-inner { display: flex; align-items: center; gap: 18px; height: var(--header-h); }
.logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 20px; letter-spacing: -0.02em; }
.logo-mark {
  width: 30px; height: 30px; border-radius: 9px;
  background: var(--primary); color: var(--text-invert);
  display: grid; place-items: center; font-size: 15px;
}
.main-nav { display: flex; gap: 4px; margin-left: 8px; }
.main-nav a {
  padding: 8px 13px; border-radius: 8px; font-weight: 500; color: var(--text-2);
  transition: background 0.15s, color 0.15s;
}
.main-nav a:hover { background: var(--primary-soft); color: var(--text); }
.main-nav a.active { background: var(--primary); color: var(--text-invert); }

.header-search { flex: 1; max-width: 420px; margin-left: auto; }
.search-box { display: flex; align-items: center; background: var(--surface-3); border: 1px solid transparent; border-radius: 10px; padding: 0 6px 0 12px; transition: border 0.15s, background 0.15s; }
.search-box:focus-within { background: var(--surface); border-color: var(--border-strong); }
.search-box input { flex: 1; border: none; background: transparent; outline: none; padding: 9px 6px; color: var(--text); }
.search-box button { border: none; background: var(--primary); color: var(--text-invert); border-radius: 7px; padding: 7px 14px; font-weight: 600; font-size: 13px; }
.search-box button:hover { background: var(--primary-hover); }

.header-actions { display: flex; align-items: center; gap: 10px; margin-left: 4px; }
.cart-link { position: relative; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; color: var(--text-2); transition: background 0.15s; }
.cart-link:hover { background: var(--primary-soft); color: var(--text); }
.cart-badge {
  position: absolute; top: 3px; right: 2px; min-width: 17px; height: 17px; padding: 0 4px;
  background: var(--primary); color: var(--text-invert); border-radius: 999px;
  font-size: 11px; font-weight: 700; display: none; place-items: center;
}
.cart-badge.show { display: grid; }

.user-chip { display: flex; align-items: center; gap: 8px; padding: 5px 10px 5px 5px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); }
.user-chip:hover { background: var(--surface-2); }
.avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--primary); color: var(--text-invert); display: grid; place-items: center; font-size: 12px; font-weight: 700; flex: none; }
.user-chip .name { font-weight: 600; font-size: 13px; color: var(--text); max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  border: 1px solid transparent; border-radius: var(--radius-sm);
  padding: 9px 16px; font-size: 14px; font-weight: 600; line-height: 1.2;
  transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.05s;
  white-space: nowrap;
}
.btn:active { transform: translateY(1px); }
.btn:disabled { opacity: 0.55; cursor: not-allowed; }
.btn-primary { background: var(--primary); color: var(--text-invert); }
.btn-primary:hover:not(:disabled) { background: var(--primary-hover); }
.btn-outline { background: var(--surface); color: var(--text); border-color: var(--border-strong); }
.btn-outline:hover:not(:disabled) { background: var(--surface-2); border-color: var(--text-3); }
.btn-ghost { background: transparent; color: var(--text-2); }
.btn-ghost:hover:not(:disabled) { background: var(--primary-soft); color: var(--text); }
.btn-danger { background: var(--danger); color: #fff; }
.btn-danger:hover:not(:disabled) { background: #8f1c13; }
.btn-danger-soft { background: var(--danger-soft); color: var(--danger); }
.btn-danger-soft:hover:not(:disabled) { background: #fbdad6; }
.btn-sm { padding: 6px 11px; font-size: 13px; border-radius: 7px; }
.btn-lg { padding: 12px 20px; font-size: 15px; }
.btn-block { width: 100%; }
.btn-icon { padding: 7px; border-radius: 7px; }

/* ---------- Forms ---------- */
.field { margin-bottom: 16px; }
.label { display: block; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 6px; }
.input, .select, .textarea {
  width: 100%; padding: 10px 13px; border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm); background: var(--surface); color: var(--text);
  outline: none; transition: border 0.15s, box-shadow 0.15s;
}
.input:focus, .select:focus, .textarea:focus { border-color: var(--text-3); box-shadow: 0 0 0 3px var(--ring); }
.textarea { resize: vertical; min-height: 96px; }
.form-hint { font-size: 12px; color: var(--text-3); margin-top: 5px; }
.form-error { font-size: 12.5px; color: var(--danger); margin-top: 5px; }
.input-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

/* ---------- Cards & layout helpers ---------- */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
.card-pad { padding: 22px; }
.muted { color: var(--text-3); }
.small { font-size: 13px; }
.bold { font-weight: 700; }
.mt-1 { margin-top: 8px; } .mt-2 { margin-top: 14px; } .mt-3 { margin-top: 22px; }
.mb-2 { margin-bottom: 14px; }
.flex { display: flex; align-items: center; gap: 10px; }
.flex-between { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.grow { flex: 1; }
.center { text-align: center; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

/* ---------- Section titles ---------- */
.section-title { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 6px 0 16px; }
.section-title h1, .section-title h2 { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; }
.section-title p { color: var(--text-3); font-size: 13px; }

/* ---------- Hero ---------- */
.hero { background: linear-gradient(180deg, #eceef0 0%, #f4f5f7 100%); border-bottom: 1px solid var(--border); }
.hero-inner { padding: 52px 20px; text-align: center; max-width: 720px; margin: 0 auto; }
.hero h1 { font-size: 38px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; }
.hero p { color: var(--text-2); margin: 14px 0 24px; font-size: 16px; }

/* ---------- Category pills ---------- */
.chips { display: flex; flex-wrap: wrap; gap: 10px; }
.chip {
  padding: 8px 16px; border-radius: 999px; border: 1px solid var(--border-strong);
  background: var(--surface); color: var(--text-2); font-size: 13.5px; font-weight: 600;
  transition: all 0.15s;
}
.chip:hover { border-color: var(--text-3); color: var(--text); }
.chip.active { background: var(--primary); border-color: var(--primary); color: var(--text-invert); }

/* ---------- Product grid ---------- */
.product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.product-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  overflow: hidden; display: flex; flex-direction: column; transition: box-shadow 0.18s, transform 0.18s, border-color 0.18s;
}
.product-card:hover { box-shadow: var(--shadow); border-color: var(--border-strong); transform: translateY(-2px); }
.product-media { position: relative; aspect-ratio: 1 / 1; background: var(--surface-3); overflow: hidden; }
.product-media img { width: 100%; height: 100%; object-fit: cover; }
.img-placeholder { width: 100%; height: 100%; display: grid; place-items: center; font-size: 52px; font-weight: 800; color: var(--border-strong); background: linear-gradient(160deg, #f1f2f4, #e7e9ec); }
.product-out { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(244,245,247,0.82); color: var(--text-3); font-weight: 700; font-size: 13px; letter-spacing: 0.05em; }
.thumb .img-placeholder, .order-thumb .img-placeholder, .cart-thumb .img-placeholder { font-size: 17px; }
.product-body { padding: 13px 14px 15px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
.product-cat { font-size: 12px; color: var(--text-3); font-weight: 500; text-transform: uppercase; letter-spacing: 0.03em; }
.product-name { font-weight: 600; font-size: 14.5px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 40px; }
.product-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.price { font-weight: 800; font-size: 16px; letter-spacing: -0.01em; }
.price .cur { font-size: 12px; font-weight: 700; color: var(--text-3); }
.add-btn { border: none; background: var(--primary); color: var(--text-invert); border-radius: 8px; padding: 8px 13px; font-size: 13px; font-weight: 600; transition: background 0.15s; }
.add-btn:hover { background: var(--primary-hover); }
.add-btn:disabled { background: var(--border-strong); cursor: not-allowed; }

/* ---------- Filter bar ---------- */
.filter-bar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }
.filter-bar .spacer { flex: 1; }
.select { width: auto; padding: 9px 34px 9px 13px; }

/* ---------- Pagination ---------- */
.pagination { display: flex; justify-content: center; gap: 8px; margin-top: 28px; }
.pagination button { border: 1px solid var(--border-strong); background: var(--surface); border-radius: 8px; padding: 8px 13px; font-size: 13px; font-weight: 600; color: var(--text-2); }
.pagination button:hover:not(:disabled) { background: var(--surface-2); }
.pagination button.active { background: var(--primary); border-color: var(--primary); color: var(--text-invert); }
.pagination button:disabled { opacity: 0.4; cursor: not-allowed; }

/* ---------- Product detail ---------- */
.detail-grid { display: grid; grid-template-columns: 460px 1fr; gap: 36px; }
.detail-media { aspect-ratio: 1 / 1; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); background: var(--surface-3); }
.detail-media img { width: 100%; height: 100%; object-fit: cover; }
.detail-info h1 { font-size: 26px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.25; }
.detail-price { font-size: 30px; font-weight: 800; margin: 14px 0; }
.detail-meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
.detail-desc { color: var(--text-2); margin: 16px 0; white-space: pre-line; }
.qty-stepper { display: inline-flex; align-items: center; border: 1px solid var(--border-strong); border-radius: 9px; overflow: hidden; }
.qty-stepper button { border: none; background: var(--surface-2); width: 38px; height: 40px; font-size: 18px; color: var(--text-2); }
.qty-stepper button:hover { background: var(--surface-3); }
.qty-stepper input { width: 52px; height: 40px; border: none; text-align: center; font-weight: 700; outline: none; }

.stars { color: #d3b64f; font-size: 15px; letter-spacing: 2px; }
.stars .off { color: var(--border-strong); }
.stars.small { font-size: 13px; }

/* ---------- Star rating input ---------- */
.rating-input { display: flex; gap: 4px; font-size: 26px; }
.rating-input span { cursor: pointer; color: var(--border-strong); transition: color 0.1s; }
.rating-input span.on { color: #d3b64f; }

/* ---------- Cart ---------- */
.cart-layout { display: grid; grid-template-columns: 1fr 340px; gap: 22px; align-items: start; }
.cart-row { display: flex; gap: 16px; padding: 16px; border-bottom: 1px solid var(--border); align-items: center; }
.cart-row:last-child { border-bottom: none; }
.cart-thumb { width: 78px; height: 78px; border-radius: 10px; overflow: hidden; background: var(--surface-3); flex: none; }
.cart-thumb img { width: 100%; height: 100%; object-fit: cover; }
.cart-row .name { font-weight: 600; font-size: 14.5px; }
.cart-row .unit { font-size: 13px; color: var(--text-3); }
.summary-row { display: flex; justify-content: space-between; padding: 9px 0; font-size: 14.5px; }
.summary-row.total { border-top: 1px solid var(--border); margin-top: 6px; padding-top: 14px; font-size: 17px; font-weight: 800; }

/* ---------- Order status badges ---------- */
.badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
.badge-pending { background: var(--warning-soft); color: var(--warning); }
.badge-confirmed { background: var(--info-soft); color: var(--info); }
.badge-shipping { background: #eef2f7; color: #4a5b76; }
.badge-completed { background: var(--success-soft); color: var(--success); }
.badge-cancelled { background: var(--danger-soft); color: var(--danger); }
.badge-active { background: var(--success-soft); color: var(--success); }
.badge-inactive { background: var(--danger-soft); color: var(--danger); }
.badge-locked { background: var(--danger-soft); color: var(--danger); }
.badge-admin { background: var(--primary-soft); color: var(--text); }
.badge-customer { background: var(--surface-3); color: var(--text-2); }

/* ---------- Orders list ---------- */
.order-card { padding: 0; overflow: hidden; }
.order-head { display: flex; align-items: center; gap: 14px; padding: 16px 20px; background: var(--surface-2); border-bottom: 1px solid var(--border); flex-wrap: wrap; }
.order-code { font-weight: 700; }
.order-items { padding: 6px 20px; }
.order-item { display: flex; gap: 14px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--border); }
.order-item:last-child { border-bottom: none; }
.order-thumb { width: 56px; height: 56px; border-radius: 9px; overflow: hidden; background: var(--surface-3); flex: none; }
.order-thumb img { width: 100%; height: 100%; object-fit: cover; }
.order-foot { padding: 14px 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

/* ---------- Auth ---------- */
.auth-wrap { max-width: 420px; margin: 30px auto; }
.auth-card { padding: 30px; }
.auth-card h1 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; }
.auth-card .sub { color: var(--text-3); margin: 6px 0 22px; }

/* ---------- Toast ---------- */
.toast-root { position: fixed; top: 78px; right: 20px; z-index: 200; display: flex; flex-direction: column; gap: 10px; }
.toast { background: var(--text); color: var(--text-invert); padding: 12px 16px; border-radius: 10px; box-shadow: var(--shadow-lg); display: flex; align-items: center; gap: 10px; min-width: 240px; max-width: 340px; animation: toast-in 0.22s ease; font-size: 14px; }
.toast.success { background: #14532d; }
.toast.error { background: #7f1d1d; }
.toast.info { background: var(--text); }
@keyframes toast-in { from { opacity: 0; transform: translateX(14px); } to { opacity: 1; transform: none; } }

/* ---------- Modal ---------- */
.modal-backdrop { position: fixed; inset: 0; background: rgba(20,22,26,0.45); z-index: 120; display: none; align-items: flex-start; justify-content: center; padding: 40px 16px; overflow-y: auto; }
.modal-backdrop.open { display: flex; }
.modal { background: var(--surface); border-radius: var(--radius); width: 100%; max-width: 520px; box-shadow: var(--shadow-lg); animation: modal-in 0.18s ease; }
@keyframes modal-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
.modal-head { display: flex; align-items: center; justify-content: space-between; padding: 18px 22px; border-bottom: 1px solid var(--border); }
.modal-head h3 { font-size: 17px; font-weight: 700; }
.modal-body { padding: 20px 22px; }
.modal-foot { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 22px; border-top: 1px solid var(--border); }
.modal-close { border: none; background: transparent; font-size: 22px; color: var(--text-3); line-height: 1; padding: 0 4px; }

/* ---------- Empty state ---------- */
.empty { text-align: center; padding: 60px 20px; color: var(--text-3); }
.empty .ico { font-size: 44px; margin-bottom: 12px; }
.empty h3 { color: var(--text-2); font-size: 17px; margin-bottom: 6px; }

/* ---------- Alerts ---------- */
.alert { border-radius: var(--radius-sm); padding: 12px 15px; font-size: 14px; display: flex; gap: 9px; align-items: flex-start; }
.alert-error { background: var(--danger-soft); color: var(--danger); }
.alert-success { background: var(--success-soft); color: var(--success); }
.alert-info { background: var(--info-soft); color: var(--info); }

/* ---------- Footer ---------- */
.site-footer { background: var(--surface); border-top: 1px solid var(--border); margin-top: 20px; }
.footer-inner { display: flex; flex-wrap: wrap; gap: 30px; justify-content: space-between; padding: 36px 20px; }
.footer-col h4 { font-size: 14px; font-weight: 700; margin-bottom: 12px; }
.footer-col a, .footer-col p { display: block; color: var(--text-3); font-size: 13.5px; margin-bottom: 7px; }
.footer-col a:hover { color: var(--text); }
.footer-bottom { border-top: 1px solid var(--border); padding: 16px 20px; text-align: center; color: var(--text-3); font-size: 12.5px; }

/* ============================================================
   Admin layout
   ============================================================ */
.admin-body { background: var(--bg); }
.admin-shell { display: grid; grid-template-columns: 250px 1fr; min-height: 100vh; }
.admin-side { background: var(--surface); border-right: 1px solid var(--border); position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; }
.admin-side .brand { padding: 20px 22px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
.admin-nav { padding: 14px 12px; display: flex; flex-direction: column; gap: 3px; flex: 1; }
.admin-nav a { display: flex; align-items: center; gap: 11px; padding: 10px 13px; border-radius: 9px; color: var(--text-2); font-weight: 500; font-size: 14px; transition: background 0.15s, color 0.15s; }
.admin-nav a:hover { background: var(--primary-soft); color: var(--text); }
.admin-nav a.active { background: var(--primary); color: var(--text-invert); }
.admin-nav .ico { width: 20px; text-align: center; }
.admin-side .side-foot { padding: 14px 20px; border-top: 1px solid var(--border); }

.admin-main { padding: 26px 30px; }
.admin-topbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
.admin-topbar h1 { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; }

.stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.stat-card { padding: 20px; display: flex; flex-direction: column; gap: 6px; }
.stat-card .label { font-size: 12.5px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.03em; margin: 0; }
.stat-card .value { font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }
.stat-card .sub { font-size: 12.5px; color: var(--text-3); }

.admin-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.admin-table th { text-align: left; padding: 12px 16px; color: var(--text-3); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; border-bottom: 1px solid var(--border); background: var(--surface-2); }
.admin-table td { padding: 13px 16px; border-bottom: 1px solid var(--border); vertical-align: middle; }
.admin-table tr:last-child td { border-bottom: none; }
.admin-table tr:hover td { background: var(--surface-2); }
.admin-table .thumb { width: 42px; height: 42px; border-radius: 8px; overflow: hidden; background: var(--surface-3); }
.admin-table .thumb img { width: 100%; height: 100%; object-fit: cover; }
.table-actions { display: flex; gap: 6px; }

/* ---------- Responsive ---------- */
@media (max-width: 1020px) {
  .product-grid { grid-template-columns: repeat(3, 1fr); }
  .detail-grid { grid-template-columns: 1fr; }
  .stat-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 760px) {
  .product-grid { grid-template-columns: repeat(2, 1fr); }
  .cart-layout { grid-template-columns: 1fr; }
  .main-nav { display: none; }
  .header-search { display: none; }
  .admin-shell { grid-template-columns: 1fr; }
  .admin-side { position: static; height: auto; }
  .admin-nav { flex-direction: row; flex-wrap: wrap; }
  .input-row, .grid-2 { grid-template-columns: 1fr; }
  .hero h1 { font-size: 28px; }
}
